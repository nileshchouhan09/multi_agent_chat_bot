
# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.*
**/.env
**/.env.*

# Allow safe environment templates
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# Secret keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ==========================================
# NODE.JS DEPENDENCIES
# ==========================================
node_modules/
**/node_modules/

# ==========================================
# LOGS
# ==========================================
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# BUILD OUTPUT
# ==========================================
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# ==========================================
# CACHE & TEMPORARY FILES
# ==========================================
.cache/
**/.cache/
.npm/
.eslintcache
tmp/
temp/
**/tmp/
**/temp/
*.pid
*.pid.lock

# ==========================================
# DOCKER LOCAL OVERRIDES
# Keep docker-compose.yml and Dockerfiles tracked
# ==========================================
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# ==========================================
# LOCAL DATABASES & BACKUPS
# ==========================================
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
backups/
**/backups/

# ==========================================
# GENERATED FILES
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# Google Cloud credentials
serviceAccountKey.json
**/serviceAccountKey.json
*service-account*.json